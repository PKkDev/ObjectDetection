<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <!-- Тесты не запускают модели, поэтому нативные библиотеки ONNX Runtime (CUDA и др.) в выходную папку не копируем -->
  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.24.4" ExcludeAssets="native;build;buildTransitive" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Gpu" Version="1.13.1" ExcludeAssets="native;build;buildTransitive" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\YOLO3.Shared\YOLO3.Shared.csproj" />
    <ProjectReference Include="..\YOLO4.Shared\YOLO4.Shared.csproj" />
    <ProjectReference Include="..\YOLO26.Shared\YOLO26.Shared.csproj" />
    <ProjectReference Include="..\YOLO26.Transformer\YOLO26.Transformer.csproj" />
  </ItemGroup>

</Project>